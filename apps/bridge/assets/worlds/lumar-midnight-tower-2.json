    {
      "x": 5,
      "y": 5,
      "type": "dialog",
      "label": "IDRIS THORNE",
      "prompt": "PRESS E TO TALK",
      "dialog": "A MAN MADE OF COLD LIGHT, HIS ROBES MOVING IN A CURRENT THAT ISN'T THERE, WATER RUNNING FROM HIS SLEEVES AND NEVER REACHING THE FLOOR.\n\n\"AH. A VISITOR WITH A PULSE. SIT, IF YOU LIKE. I CAN'T.\""
    },
    {
      "x": 6,
      "y": 7,
      "type": "dialog",
      "label": "WARD CIRCLE",
      "prompt": "PRESS E TO STUDY",
      "dialog": "A WARD OF PALE BLUE LIGHT, SIXTEEN GLYPHS ROUND ITS RIM, SIX CANDLES THAT BURN COLD.\n\nIT ISN'T KEEPING ANYTHING OUT. IT'S KEEPING SOMEONE IN - GENTLY, THE WAY YOU'D HOLD A CANDLE OUT OF THE WIND."
    },
    {
      "x": 6,
      "y": 3,
      "type": "dialog",
      "label": "BLACK MIRROR",
      "prompt": "PRESS E TO LOOK",
      "dialog": "AN OVAL OF GLASS SO DARK IT DRINKS THE CANDLELIGHT. IN IT THE ROOM IS THE SAME, EXCEPT THAT IT'S FULL OF WATER, AND SOMEONE IS STANDING BEHIND YOU.\n\nYOU DON'T TURN ROUND."
    },
    {
      "x": 4,
      "y": 3,
      "type": "dialog",
      "label": "BOOKSHELF",
      "prompt": "PRESS E TO LOOK",
      "dialog": "THE BOOKS SHE READS, NOT THE ONES SHE SHOWS: 'TIDES OF THE WEAVE', 'ON BINDING THE DROWNED (AND WHY YOU SHOULDN'T)', 'SALTMERE: A PARISH HISTORY', AND A CHILDREN'S BOOK OF SEA SHANTIES, VERY WORN."
    },
    {
      "x": 3,
      "y": 5,
      "type": "dialog",
      "label": "BED",
      "prompt": "PRESS E TO LOOK",
      "dialog": "A NARROW BED UNDER A CANOPY OF LITTLE HANGING STARS. THE BLACK CAT HAS TAKEN THE PILLOW AND WILL NOT BE DISCUSSING IT."
    },
    {
      "x": 9,
      "y": 5,
      "type": "dialog",
      "label": "THE STILL",
      "prompt": "PRESS E TO LOOK",
      "dialog": "A COPPER STILL TICKING OVER A BLUE FLAME. WHAT DRIPS INTO THE FLASK GLOWS GREEN.\n\nA LABEL IN HER HAND: 'MOONWATER - FOR THE DROWNED, WHO ARE ALWAYS THIRSTY.'"
    },
    {
      "x": 9,
      "y": 7,
      "type": "dialog",
      "label": "DRYING HERBS",
      "prompt": "PRESS E TO LOOK",
      "dialog": "BUNDLES HUNG UPSIDE DOWN TO DRY: SEA LAVENDER, WORMWOOD, BLACK SAMPHIRE, AND SOMETHING THAT HUMS WHEN YOU BREATHE ON IT."
    },
    {
      "x": 9,
      "y": 9,
      "type": "dialog",
      "label": "RAVEN",
      "prompt": "PRESS E TO LOOK",
      "dialog": "A RAVEN ON A PERCH. IT LOOKS AT YOU WITH ONE GOLD EYE, THEN THE OTHER.\n\n\"SALTMERE,\" IT SAYS, QUITE CLEARLY, AND GOES BACK TO SLEEP."
    },
    {
      "x": 7,
      "y": 9,
      "type": "dialog",
      "label": "GRIMOIRE",
      "prompt": "PRESS E TO READ",
      "dialog": "A BOOK CHAINED TO ITS LECTERN, OPEN AT A PAGE OF TIDE TABLES THAT DON'T MATCH ANY TIDE YOU KNOW.\n\nIN THE MARGIN: 'THE BELL RINGS AT THE NEW MOON. THE SHIP COMES WHEN IT RINGS. - I.T.'"
    },
    {
      "x": 3,
      "y": 3,
      "type": "dialog",
      "label": "WINDOW",
      "prompt": "PRESS E TO LOOK",
      "dialog": "THE MIDNIGHT SEA UNDER A WHITE MOON, MIST LYING ON IT LIKE A SHEET OVER FURNITURE.\n\nFAR OUT, A LIGHT THAT ISN'T A STAR MOVES AGAINST THE WIND."
    }
  ],
