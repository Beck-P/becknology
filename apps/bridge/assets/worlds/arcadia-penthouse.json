    },
    {
      "x": 30,
      "y": 8,
      "type": "dialog",
      "label": "THE POOL",
      "prompt": "PRESS E TO SWIM",
      "dialog": "A PLUNGE POOL LIT FROM BELOW, WARM AS A BATH, ITS FAR EDGE SPILLING AWAY TOWARD THE TOWERS. THE WATER SMELLS FAINTLY OF THE SEA ON LUMAR. SOMEBODY IMPORTED IT.",
      "action": "sleep",
      "rest": 1.4
    },
    {
      "x": 25,
      "y": 4,
      "type": "dialog",
      "label": "LOUNGER",
      "prompt": "PRESS E TO LIE BACK",
      "dialog": "WARM CUSHIONS, A TOWEL ROLLED UNDER YOUR NECK, THE TRAFFIC SLIDING PAST TWO HUNDRED FLOORS DOWN.",
      "action": "sit",
      "seat": [
        25.3,
        4.3
      ],
      "facing": "down",
      "view": "skyline"
    },
    {
      "x": 26,
      "y": 4,
      "type": "dialog",
      "label": "LOUNGER",
      "prompt": "PRESS E TO LIE BACK",
      "dialog": "THE RAIN NEVER QUITE REACHES THIS FAR UP. IT JUST GLITTERS ON THE GLASS.",
      "action": "sit",
      "seat": [
