    {
      "x": 10,
      "y": 4,
      "type": "dialog",
      "label": "GLOBE",
      "prompt": "PRESS E TO LOOK",
      "dialog": "LUMAR, IN PAINTED\\nWOOD. MOSTLY GREEN SEA.\\n\\nSOMEONE HAS SCRATCHED\\nA SMALL X NEAR THE\\nSOUTH POLE."
    },
    {
      "x": 8,
      "y": 3,
      "type": "dialog",
      "label": "TELESCOPE",
      "prompt": "PRESS E TO PEER",
      "dialog": "AIMED AT THE SKY.\\n\\nYOU FIND A BRIGHT\\nMOVING STAR \u2014 YOUR\\nOWN SHIP, IN ORBIT."
    },
    {
      "x": 11,
      "y": 2,
      "type": "dialog",
