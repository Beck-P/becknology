    {
      "x": 4,
      "y": 4,
      "type": "dialog",
      "label": "MAP DESK",
      "prompt": "PRESS E TO LOOK",
      "dialog": "A HALF-INKED CHART OF\\nTHE ROSE ISLE.\\n\\nTHE COASTLINE STOPS\\nMID-STROKE, THE QUILL\\nSTILL WET."
